  "grammar": {
    "standard": {
      "title": "Venir de + Infinitive (Recent Past)",
      "explanation": "Venir de + infinitive expresses something that just happened (recent past). For example, 'Je viens de manger' means 'I just ate.' To use this construction, conjugate the verb venir in the present tense, then add 'de' followed by an infinitive. The verb venir is irregular: je viens, tu viens, il/elle/on vient, nous venons, vous venez, ils/elles viennent. Examples: elle vient de partir (she just left), nous venons d'arriver (we just arrived). This is different from passé composé, which refers to a less immediate past.",
      "examples": [
        {
          "french": "Je viens de manger.",
          "english": "I just ate."
        },
        {
          "french": "Tu viens de partir.",
          "english": "You just left."
        },
        {
          "french": "Nous venons d'arriver.",
          "english": "We just arrived."
        },
        {
          "french": "Ils viennent de terminer.",
          "english": "They just finished."
        }
      ],
