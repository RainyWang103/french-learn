  "grammar": {
    "standard": {
      "title": "Spelling-Change Verbs (-cer / -ger)",
      "explanation": "Verbs ending in -cer and -ger have spelling changes to keep their pronunciation. For -cer verbs, add a cedilla (ç) before -ons: nous commençons (not 'commençons'). For -ger verbs, add an -e before -ons: nous mangeons, nous voyageons. This only affects the nous form in present tense. Examples: commencer → nous commençons; manger → nous mangeons; voyager → nous voyageons; lancer → nous lançons. The other forms keep the original spelling.",
      "examples": [
        {
          "french": "Nous commençons à parler.",
          "english": "We begin to speak."
        },
        {
          "french": "Vous mangez à midi.",
          "english": "You eat at noon."
        },
        {
          "french": "Elle voyage souvent.",
          "english": "She travels often."
        },
        {
          "french": "Je lance la balle.",
          "english": "I throw the ball."
        }
      ],
