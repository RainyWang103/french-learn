  "grammar": {
    "standard": {
      "title": "Adverbs of Manner (-ment suffix formation)",
      "explanation": "French adverbs of manner are formed by adding the suffix '-ment' to the feminine form of an adjective. For example: 'lent' (slow) becomes 'lente' (feminine), then 'lentement' (slowly). 'Doux' (soft) becomes 'douce,' then 'doucement' (softly). If the adjective already ends in a vowel, add '-ment' directly without changing the form: 'facile' → 'facilement' (easily). 'Vrai' → 'vraiment' (truly). There are some irregular adverbs of manner: 'bien' (well), 'mal' (badly), 'vite' (quickly). Adverbs of manner typically follow the verb: 'Il parle lentement.' (He speaks slowly.)",
      "examples": [
        {
          "french": "Il parle lentement.",
          "english": "He speaks slowly."
        },
        {
          "french": "Elle marche doucement.",
          "english": "She walks softly."
        },
        {
          "french": "Ils travaillent sérieusement.",
          "english": "They work seriously."
        },
        {
          "french": "Elle parle rapidement.",
          "english": "She speaks quickly."
        },
        {
          "french": "Il joue bien du piano.",
          "english": "He plays piano well."
        }
      ],
